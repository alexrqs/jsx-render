{
  "name": "jsx-render",
  "version": "1.4.0",
  "description": "A tiny library to render JSX as real DOM nodes, without React",
  "bundle": "docs/jsx.js",
  "main": "lib/dom.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexrqs/jsx-render.git"
  },
  "keywords": [
    "JSX",
    "jsx-render",
    "SVG-JSX"
  ],
  "author": "Aleks",
  "bugs": {
    "url": "https://github.com/alexrqs/jsx-render/issues"
  },
  "homepage": "https://github.com/alexrqs/jsx-render#readme",
  "license": "MIT",
  "scripts": {
    "start": "webpack serve --config examples/webpack.config.js --hot",
    "dev": "babel src --out-dir lib --watch",
    "build": "babel src --out-dir lib && webpack",
    "eslint": "eslint src/.",
    "prepare": "husky",
    "prepublishOnly": "npm run test && npm run build",
    "posttest": "npm run eslint",
    "test": "ava"
  },
  "ava": {
    "files": [
      "test/test.*.js"
    ],
    "require": [
      "@babel/register",
      "./test/helpers/setup-browser-env.js"
    ]
  },
  "devDependencies": {
    "@babel/cli": "^7.28.0",
    "@babel/core": "^7.28.0",
    "@babel/plugin-syntax-jsx": "^7.27.1",
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@babel/register": "^7.27.1",
    "ava": "^6.4.0",
    "babel-loader": "^9.2.1",
    "babel-preset-primavera": "^1.3.0",
    "browser-env": "^3.3.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.31.0",
    "html-webpack-plugin": "^5.6.3",
    "husky": "^9.1.7",
    "prettier": "^3.5.0",
    "pretty-quick": "^4.0.0",
    "redux": "^5.0.1",
    "webpack": "^5.97.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0"
  },
  "optionalDependencies": {
    "cheerio": "^1.0.0"
  }
}
